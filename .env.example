# Kopiere diese Datei nach .env und trage deinen Key ein.
# .env wird nicht versioniert und niemals an den Browser ausgeliefert.
# Änderungen an der .env erkennt der lokale Proxy im laufenden Betrieb.
#
# Anbieter: "gemini" oder "zai". Ohne AI_PROVIDER entscheidet der vorhandene Key:
# GEMINI_API_KEY → Gemini, sonst Z.ai.

AI_PROVIDER=

# Gemini (https://aistudio.google.com/apikey)
# Standardmodell: gemini-4-hydrogen (OpenAI-kompatibel, versteht auch Bilder)
GEMINI_API_KEY=

# Z.ai (https://z.ai → API Keys) — Alternative
ZAI_API_KEY=

# Optional: jede andere OpenAI-kompatible API überschreiben.
# AI_API_BASE=https://api.example.com/v1
AI_API_BASE=

# Optional: Modell überschreiben (Standard je Anbieter:
# Gemini → gemini-4-hydrogen, Z.ai → glm-4-flash)
AI_MODEL=

# Websuche. Ohne weitere Angabe nutzt Jarvis die keylose Bing-RSS-Suche.
# Suchanfragen gehen dabei an den jeweiligen Anbieter, nie API-Keys.
# Für stabilere Treffer: brave oder tavily mit Key, oder ein eigenes SearXNG.
# SEARCH_PROVIDER=auto
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SEARXNG_URL=http://127.0.0.1:8080
# SEARCH_COUNT=5

# ElevenLabs als zweite Cloud-Stimme (optional).
# Der Key wird nur im Electron-Main-Prozess gelesen, nie an den Browser gegeben.
# Standardstimme: mdy0XxrJgPxKAMK5Wexl (überschreibbar mit ELEVENLABS_VOICE_ID)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=mdy0XxrJgPxKAMK5Wexl
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Port des lokalen Proxys (Vite leitet /api dorthin weiter)
PORT=8787
